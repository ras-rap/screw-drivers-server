# ---- layout ------------------------------------------------------------------
# Loopback port the panel listens on; nginx proxies to 127.0.0.1:<PANEL_PORT>.
PANEL_PORT=3000
# Public URL, informational (written by ./setup.sh --host).
PANEL_PUBLIC_URL=

# ---- auth (Clerk, hosted free tier) -----------------------------------------
# Create an application at https://dashboard.clerk.com, then copy the keys.
# Enable "Discord" under User & Authentication -> Social connections.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk redirects here after sign-in; keep the built-in page.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/

# ---- who may use the panel ---------------------------------------------------
# Comma-separated. Both empty = any signed-in Clerk user. The /admin page can
# extend these lists at runtime; the environment lists always stay in force.
PANEL_ALLOWED_EMAILS=
PANEL_ALLOWED_USER_IDS=

# ---- admins (required for /admin) --------------------------------------------
# Comma-separated Clerk emails / user ids. Environment only, so a hijacked panel
# session cannot promote itself. Nobody can open /admin while these are empty.
PANEL_ADMIN_EMAILS=
PANEL_ADMIN_USER_IDS=

# ---- servers -----------------------------------------------------------------
# Servers added in /admin live in PANEL_DATA_FILE and need nothing here.
# PANEL_SERVERS (inline JSON) / PANEL_SERVERS_FILE add read-only entries on top,
# e.g. when they are provisioned by your deployment tooling.
PANEL_SERVERS=
PANEL_SERVERS_FILE=
PANEL_DATA_FILE=./data/panel.json

# ---- Pterodactyl (optional) --------------------------------------------------
# Application API of your Pterodactyl panel. Lets /admin import its servers and lets
# the overview start a server whose container is stopped. Application key (ptla_…)
# with "Servers: read" + "Servers: power" permissions. Empty = feature off.
PTERODACTYL_URL=
PTERODACTYL_API_KEY=

# ---- local development -------------------------------------------------------
# 1 = skip Clerk and act as a fake "dev" user. NEVER leave this on in production.
PANEL_DEV_AUTH=0
