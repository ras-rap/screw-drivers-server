# Copy to .env and adjust. Everything here is optional except the game files.
SERVER_NAME=Screw Drivers Server
SERVER_PASSWORD=
MAX_PLAYERS=8
SERVER_PORT=38000

# Who becomes host (can change server settings in-game).
# 0 = no host yet, claim it in-game via "Server Settings" with the password
#     printed to the console as "Generated random host password: xxxxxxxx"
#     (also stored in host_password.txt next to the server executable).
HOST_STEAM_ID=0
# 1 = first player to connect becomes host (convenient, but anyone can grab it).
ALLOW_FIRST_PLAYER_HOST=0

# 1 = enable Noble Connect NAT punch-through relay instead of direct connect.
# Only needed when you cannot forward the UDP port.
NOBLE_CONNECT=0

# Free-form extra arguments appended to the server command line.
EXTRA_ARGS=

# 1 = pull the newest build through steamcmd on every start. Needs a Steam
# account that owns Screw Drivers (AppID 1279510) and ~10 GB free space.
AUTO_UPDATE=0
STEAM_USERNAME=
STEAM_PASSWORD=
# Only needed the first time steamcmd logs in from a new IP.
STEAM_GUARD_CODE=

# Admin API (BepInEx mod inside the container). Token empty = generated per boot,
# printed in the log. Keep it secret; it can kick players and stop the server.
ADMIN_ENABLED=1
ADMIN_BIND=0.0.0.0
ADMIN_PORT=38080
ADMIN_TOKEN=

# 0 = exit when the server process ends instead of restarting it.
RESTART_ON_EXIT=1
# 1 = accept "stop"/"shutdown"/"quit" on stdin (used by Pterodactyl's stop button).
STDIN_COMMANDS=1
